# Variables de entorno para el dashboard Sapiencia
# Copia este archivo a `.env` y completa los valores reales.
# En producción (Cloud Run) usa Secret Manager o variables de entorno del servicio.

# --- Base de datos MySQL ---
# Producción (VPC privada, default en settings.py): 10.124.80.4
# Para desarrollo local descomenta la línea siguiente:
# DB_HOST=34.70.133.119
DB_HOST=10.124.80.4
DB_PORT=3306
DB_NAME=convocatoria_sapiencia
DB_USER=
DB_PASSWORD=

# --- Aplicación ---
# Periodo activo (entero). Si no se define, usa el valor por defecto en settings.py.
CURRENT_PERIOD=16
# TTL del caché en segundos para consultas a la BD.
CACHE_TTL=300
# Activar/desactivar mensajes de depuración.
DEBUG=false
